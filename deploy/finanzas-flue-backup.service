[Unit]
Description=Consistent Flue SQLite backup and verified private offsite copy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@BACKEND_USER@
Group=@BACKEND_USER@
WorkingDirectory=@BACKEND_HOME@/finanzas-familiares/flue-current
ExecStart=/usr/bin/node scripts/flue-state-backup.ts --config @BACKEND_HOME@/.config/finanzas-familiares/worker.json
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@BACKEND_HOME@/.config/finanzas-familiares
MemoryMax=256M
CPUQuota=50%
